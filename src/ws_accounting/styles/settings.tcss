/* Settings screen styles. */

SettingsScreen {
    layout: vertical;
}

/* ── Title ─────────────────────────────────────────── */

#settings-title {
    text-style: bold;
    text-align: center;
    width: 1fr;
    padding: 1 0;
    dock: top;
    background: $surface;
}

/* ── Tabbed Content ────────────────────────────────── */

#settings-tabs {
    height: 1fr;
    width: 1fr;
}

/* ── Form layout ───────────────────────────────────── */

.settings-form {
    padding: 1 2;
    height: auto;
    max-width: 80;
}

.field-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text;
}

.settings-form Input {
    width: 1fr;
    margin-bottom: 1;
}

.settings-form Select {
    width: 1fr;
    margin-bottom: 1;
}

/* ── Switch rows ───────────────────────────────────── */

.switch-row {
    height: 3;
    margin: 1 0;
    align: left middle;
}

.switch-label {
    width: auto;
    min-width: 20;
    padding-right: 2;
}

/* ── Info note ─────────────────────────────────────── */

.info-note {
    color: $text-muted;
    margin: 1 0;
    padding: 1 2;
    border: round $panel;
}

/* ── Save buttons ──────────────────────────────────── */

.save-btn {
    margin-top: 2;
    align: right middle;
}
