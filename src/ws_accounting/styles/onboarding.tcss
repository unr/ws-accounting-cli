/* Onboarding wizard styles. */

OnboardingScreen {
    layout: vertical;
}

/* ── Outer container ───────────────────────────────── */

#onboarding-outer {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

#onboarding-title {
    text-style: bold;
    text-align: center;
    width: 1fr;
    padding: 1 0;
    color: $text;
}

#step-indicator {
    text-align: center;
    width: 1fr;
    color: $text-muted;
    margin-bottom: 1;
}

/* ── Content Switcher ──────────────────────────────── */

#onboarding-switcher {
    height: 1fr;
    width: 1fr;
}

/* ── Step containers ───────────────────────────────── */

#step-hledger,
#step-journal,
#step-currency,
#step-api-key,
#step-sample-data {
    padding: 1 4;
    height: 1fr;
    max-width: 90;
    margin: 0 auto;
}

.step-title {
    text-style: bold;
    margin-bottom: 1;
    color: $text;
}

.step-description {
    color: $text-muted;
    margin-bottom: 1;
}

.step-buttons {
    height: auto;
    dock: bottom;
    padding: 1 0;
    align: right middle;
}

.step-buttons Button {
    margin-left: 1;
}

/* ── Step 1: hledger check ─────────────────────────── */

.status-box {
    border: round $panel;
    padding: 1 2;
    margin: 1 0;
    text-align: center;
}

.status-ok {
    border: round $success;
    color: $success;
}

.status-error {
    border: round $error;
    color: $error;
}

.install-guide {
    margin: 1 0;
    padding: 1 2;
    color: $text-muted;
}

/* ── Step 2: Journal setup ─────────────────────────── */

#journal-choice-row {
    height: auto;
    margin: 1 0;
    align: center middle;
}

.choice-btn {
    margin: 0 1;
}

.info-text {
    color: $text-muted;
    margin: 1 0;
    padding: 1 2;
    border: round $panel;
}

.hidden-field {
    display: none;
}

.error-text {
    color: $error;
    margin-top: 1;
}

#journal-path-input {
    width: 1fr;
    margin: 1 0;
}

/* ── Step 3: Currency ──────────────────────────────── */

.field-label {
    margin-top: 1;
    margin-bottom: 0;
    color: $text;
}

#currency-input {
    width: 20;
    margin: 1 0;
}

/* ── Step 4: API Key ───────────────────────────────── */

#api-key-input {
    width: 1fr;
    margin: 1 0;
}

/* ── Step 5: Sample data ───────────────────────────── */

#sample-checkbox-row {
    height: auto;
    margin: 1 0;
    padding: 1 0;
}
