/* Accounts screen styles. */

AccountsScreen {
    layout: vertical;
}

#accounts-layout {
    height: 1fr;
    layout: horizontal;
    padding: 1;
}

#accounts-tree-pane {
    width: 1fr;
    max-width: 40;
    height: 1fr;
    padding: 0 1 0 0;
}

#account-tree {
    height: 1fr;
    margin-bottom: 1;
}

#account-actions {
    height: auto;
    min-height: 3;
    dock: bottom;
}

#account-actions Button {
    margin: 0 1 0 0;
    min-width: 14;
}

#accounts-detail-pane {
    width: 2fr;
    height: 1fr;
    padding: 0 0 0 1;
}

#detail-title {
    text-style: bold;
    margin-bottom: 1;
}

#detail-balance {
    height: auto;
    min-height: 3;
    border: round $primary;
    padding: 1 2;
    margin-bottom: 1;
}

#balance-display {
    text-style: bold;
}

#detail-txns-title {
    margin-top: 1;
}

#detail-txns {
    height: 1fr;
    border: round $panel;
    padding: 1;
    overflow-y: auto;
}

#detail-txns .txn-row {
    height: 1;
}

.muted-text {
    color: $text-muted;
}

/* Empty state message */
#accounts-empty-state {
    display: none;
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $panel;
    text-align: center;
    color: $text-muted;
    margin: 4 0;
    content-align: center middle;
}

/* Placeholder screen styles shared across placeholders */
.screen-placeholder {
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $primary;
    text-align: center;
    margin: 4 0;
}
