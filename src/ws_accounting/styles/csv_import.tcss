/* CSV Import screen styles */

#import-stepper {
    height: 3;
    margin: 0 1 1 1;
}

#import-switcher {
    height: 1fr;
    margin: 0 1;
}

/* File step */
#step-file {
    padding: 1 2;
}

#step-file Input {
    margin-bottom: 1;
}

#step-file Select {
    margin-bottom: 1;
}

.error-text {
    color: $error;
    margin: 1 0;
}

/* Mapping step */
#step-mapping {
    padding: 1 2;
}

#detected-info {
    color: $text-muted;
    margin-bottom: 1;
}

#mapping-fields {
    height: auto;
    margin-bottom: 1;
}

#mapping-fields Select {
    margin-bottom: 1;
}

/* Review step */
#step-review {
    padding: 1 2;
}

#review-actions {
    height: auto;
    margin-bottom: 1;
}

#review-stats {
    width: auto;
    margin-left: 2;
    padding-top: 1;
    color: $text-muted;
}

#review-table {
    height: 1fr;
}

#review-scroll {
    height: 1fr;
    border: round $primary-muted;
}

/* Summary step */
#step-summary {
    padding: 1 2;
    align: center middle;
}

.summary-card {
    padding: 2 4;
    border: round $success;
    text-align: center;
    width: auto;
}

/* Common step button rows */
#step-file Horizontal,
#step-mapping Horizontal,
#step-review Horizontal,
#step-summary Horizontal {
    height: auto;
    margin-top: 1;
}

#step-file Button,
#step-mapping Button,
#step-review Button,
#step-summary Button {
    margin-right: 1;
}
