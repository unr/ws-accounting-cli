/* Global application styles for ws-accounting. */

Screen {
    background: $background;
}

.compact-only {
    display: block;
}
.enhanced-only {
    display: none;
}

.section-title {
    text-style: bold;
    margin-bottom: 1;
    color: $text;
}

.card {
    border: round $primary;
    padding: 1 2;
    margin: 0 1;
}

.amount-positive {
    color: $success;
}

.amount-negative {
    color: $error;
}

.amount-warning {
    color: $warning;
}

/* Placeholder screen centering */
.screen-placeholder {
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $primary;
    text-align: center;
}

/* Screens with placeholder content get centered layout */
TransactionsScreen,
BudgetsScreen,
ReportsScreen,
InsightsScreen,
SettingsScreen {
    align: center middle;
}

OnboardingScreen {
    align: center middle;
}

OnboardingScreen #onboarding-welcome {
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $primary;
    text-align: center;
    margin-bottom: 1;
}

OnboardingScreen Button {
    margin: 1 auto;
}
