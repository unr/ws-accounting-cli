/* AI Insights screen styles. */

InsightsScreen {
    layout: vertical;
}

#insights-container {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

#insights-title {
    text-style: bold;
    color: $text;
    height: 1;
    margin-bottom: 1;
}

#insights-controls {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    align: left middle;
}

#insights-controls .control-label {
    width: auto;
    height: 3;
    content-align: left middle;
    padding: 1 0;
}

#insights-period-select {
    width: 24;
    margin-right: 2;
}

#btn-generate {
    margin-right: 1;
}

#btn-regenerate {
    margin-right: 1;
}

/* Warning box for missing API key */
.warning-box {
    display: none;
    width: 100%;
    height: auto;
    padding: 1 2;
    margin: 1 0;
    border: round $warning;
    color: $warning;
    background: $surface;
}

/* Loading state */
#insights-loading {
    display: none;
    width: 100%;
    height: auto;
    min-height: 5;
    align: center middle;
    content-align: center middle;
    padding: 2;
}

#insights-loading LoadingIndicator {
    width: auto;
    height: 3;
}

#loading-text {
    width: auto;
    height: 1;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

/* Insights content area */
#insights-content {
    display: none;
    height: 1fr;
    width: 1fr;
    border: round $panel;
    padding: 1 2;
    overflow-y: auto;
}

#insights-markdown {
    width: 1fr;
    height: auto;
    min-height: 10;
}

/* Timestamp footer */
.timestamp {
    display: none;
    height: 1;
    width: 100%;
    text-align: right;
    color: $text-muted;
    margin-top: 1;
}

/* Empty state */
.empty-state {
    display: none;
    width: 100%;
    height: auto;
    padding: 3 4;
    text-align: center;
    color: $text-muted;
    border: round $panel;
    margin: 2 4;
    content-align: center middle;
}

/* Section title class */
.screen-title {
    text-style: bold;
    color: $text;
    width: 100%;
}
