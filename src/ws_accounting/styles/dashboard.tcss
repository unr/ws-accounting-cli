/* Dashboard screen styles. */

DashboardScreen {
    layout: vertical;
}

#summary-cards {
    height: auto;
    min-height: 7;
    padding: 1 0;
    layout: horizontal;
}

#summary-cards SummaryCard {
    width: 1fr;
}

#dashboard-body {
    height: 1fr;
    layout: horizontal;
    padding: 0 1;
}

#budget-section {
    width: 1fr;
    height: 1fr;
    padding: 0 1 0 0;
}

#budget-bars {
    height: 1fr;
    border: round $panel;
    padding: 1;
    overflow-y: auto;
}

#recent-section {
    width: 1fr;
    height: 1fr;
    padding: 0 0 0 1;
}

#recent-txns {
    height: 1fr;
    border: round $panel;
    padding: 1;
    overflow-y: auto;
}

.txn-row {
    height: 1;
}

.muted-text {
    color: $text-muted;
}

#quick-actions {
    dock: bottom;
    height: auto;
    min-height: 3;
    padding: 1 1;
}

#empty-state {
    display: none;
    width: 100%;
    height: 1fr;
    align: center middle;
}

#empty-msg {
    width: auto;
    height: auto;
    padding: 2 4;
    border: round $primary;
    text-align: center;
}

BudgetBar {
    height: 2;
    margin-bottom: 1;
}

BudgetBar .budget-label {
    width: 16;
    text-style: bold;
}

BudgetBar .budget-amount {
    width: 14;
    text-align: right;
}
