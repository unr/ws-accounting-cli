/* Reports screen styles. */

ReportsScreen {
    layout: vertical;
}

#reports-container {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

#reports-title {
    text-style: bold;
    color: $text;
    height: 1;
    margin-bottom: 1;
}

#reports-period {
    height: auto;
    margin-bottom: 1;
}

#reports-tabs {
    height: 1fr;
}

/* Chart widgets fill the available space */
PlotextPlot {
    width: 1fr;
    height: 1fr;
    min-height: 12;
}

/* DataTable for comparison tab */
#comparison-table {
    width: 1fr;
    height: 1fr;
    min-height: 10;
}

/* Empty state messages */
.empty-state {
    display: none;
    width: 100%;
    height: auto;
    padding: 3 4;
    text-align: center;
    color: $text-muted;
    border: round $panel;
    margin: 2 4;
    content-align: center middle;
}

/* Section title class */
.screen-title {
    text-style: bold;
    color: $text;
    width: 100%;
}
