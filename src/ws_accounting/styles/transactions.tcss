/* Transactions screen styles. */

/* ── Toolbar ─────────────────────────────────────────── */

#txn-toolbar {
    height: auto;
    min-height: 3;
    padding: 0 1;
    dock: top;
    background: $surface;
}

#search-input {
    width: 1fr;
    margin-right: 1;
}

#status-filter {
    width: 18;
    margin-right: 1;
}

#review-badge {
    width: auto;
    height: 1;
    padding: 0 1;
    margin: 1 0 0 1;
    background: $warning;
    color: $background;
    text-style: bold;
    display: none;
}

#review-badge.visible {
    display: block;
}

/* ── Main content ────────────────────────────────────── */

#txn-content {
    height: 1fr;
}

#txn-table {
    height: 1fr;
}

#loading-indicator {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    display: none;
}

#loading-indicator.visible {
    display: block;
}

#empty-state {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    display: none;
}

#empty-state.visible {
    display: block;
}

/* ── Quick-add bar ───────────────────────────────────── */

#quick-add-bar {
    height: 3;
    dock: bottom;
    padding: 0 1;
    background: $surface;
}

#quick-add-input {
    width: 1fr;
}

/* ── Help overlay ────────────────────────────────────── */

#help-overlay {
    display: none;
}

#help-overlay.visible {
    display: block;
    layer: overlay;
    width: 52;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: round $primary;
    padding: 1 2;
    offset-x: 50%;
    margin-top: 4;
}
