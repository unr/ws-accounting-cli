; Chase checking account CSV rules
; Typically: Details,Posting Date,Description,Amount,Type,Balance,Check or Slip #

skip 1

fields Details, date, description, amount, type, balance, _

date-format %m/%d/%Y
currency $
account1 assets:bank:checking

if PAYROLL
 account2 income:salary

if WHOLEFDS\|WHOLE FOODS
 account2 expenses:food:groceries

if SHELL\|CHEVRON\|EXXON
 account2 expenses:transportation:gas

if NETFLIX
 account2 expenses:subscriptions

if SPOTIFY
 account2 expenses:subscriptions
