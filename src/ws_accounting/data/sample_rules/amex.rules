; American Express CSV rules
; Typically: Date,Description,Amount

skip 1

fields date, description, amount

date-format %m/%d/%Y
currency $
account1 liabilities:credit card

if AMAZON
 account2 expenses:shopping:general

if NETFLIX
 account2 expenses:subscriptions

if SPOTIFY
 account2 expenses:subscriptions

if WHOLE FOODS\|TRADER JOE
 account2 expenses:food:groceries
