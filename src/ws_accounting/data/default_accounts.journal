; ws-accounting default chart of accounts
; Commodity directive — sets display format for all amounts
commodity $1,000.00

; === Assets ===
account assets:bank:checking          ; type: Cash
account assets:bank:savings           ; type: Cash
account assets:cash                   ; type: Cash
account assets:investments            ; type: Asset

; === Liabilities ===
account liabilities:credit card       ; type: Liability
account liabilities:loans             ; type: Liability

; === Income ===
account income:salary                 ; type: Revenue
account income:freelance              ; type: Revenue
account income:interest               ; type: Revenue
account income:refunds                ; type: Revenue

; === Expenses ===
account expenses:food:groceries       ; type: Expense
account expenses:food:dining          ; type: Expense
account expenses:housing:rent         ; type: Expense
account expenses:housing:utilities    ; type: Expense
account expenses:transportation:gas   ; type: Expense
account expenses:transportation:transit ; type: Expense
account expenses:health:medical       ; type: Expense
account expenses:health:insurance     ; type: Expense
account expenses:entertainment        ; type: Expense
account expenses:shopping:clothing    ; type: Expense
account expenses:shopping:general     ; type: Expense
account expenses:subscriptions        ; type: Expense
account expenses:education            ; type: Expense
account expenses:personal care        ; type: Expense
account expenses:gifts                ; type: Expense
account expenses:travel               ; type: Expense
account expenses:taxes:federal        ; type: Expense
account expenses:taxes:state          ; type: Expense
account expenses:charitable:donations ; type: Expense
account expenses:fees:bank            ; type: Expense
account expenses:miscellaneous        ; type: Expense

; === Equity ===
account equity:opening balances       ; type: Equity
